# ---------------------------------------------------------------------------
# MOTHLIGHT environment
#
# Both of these are OPTIONAL. With neither set, the game is fully playable —
# it just keeps your scores on your own device and flies you against the
# garden's resident moths instead of real players.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (the pooled one is fine).
# Vercel + Neon integration sets this for you automatically.
# Get one free at https://neon.tech
DATABASE_URL="postgresql://user:password@ep-something-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Canonical public origin. Only used to build absolute URLs for the OG share
# card. On Vercel this is derived from VERCEL_PROJECT_PRODUCTION_URL if unset.
# NEXT_PUBLIC_SITE_URL="https://mothlight.example.com"
